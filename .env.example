# MongoDB credentials (required for docker-compose prod and for dev when using Docker Mongo)
# Dev default (used by docker-compose.dev.yml if unset): admin / devpassword
# If mongo was previously started without these set, run: docker compose -f docker-compose.yml -f docker-compose.dev.yml down -v  then dev:db again.
MONGO_USERNAME=admin
MONGO_PASSWORD=password

# Database connection string
# Local dev with Docker Mongo (npm run dev:db): use 127.0.0.1:27017 with auth (must match MONGO_* above).
# If unset in dev, payload.config.ts falls back to mongodb://admin:devpassword@127.0.0.1:27017/logankuzyk?authSource=admin
# Local dev with host MongoDB (no auth): mongodb://127.0.0.1:27017/your-database-name
# Production (payload in Docker): docker-compose sets DATABASE_URL to mongo:27017
DATABASE_URL=mongodb://admin:password@127.0.0.1:27017/logankuzyk?authSource=admin

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 (S3-compatible) storage for media uploads
# When set, media uploads go to R2 instead of local storage
# R2_ENDPOINT format: https://<account_id>.r2.cloudflarestorage.com
# R2_REGION is typically 'auto' for R2
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_REGION=auto

# Public URL for storage (used when disablePayloadAccessControl is true). No trailing slash.
# Example: https://pub-xxx.r2.dev or https://cdn.example.com
# STORAGE_URL=

# Same as STORAGE_URL but exposed to the browser. Required for images to load directly from
# the CDN instead of proxying through Next.js. Set to your custom R2 domain (e.g. https://media.example.com)
# NEXT_PUBLIC_STORAGE_URL=
